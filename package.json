{
  "name": "farish",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based AI 3D-model generator — monorepo root.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "lib/*",
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "lint": "nx run-many --target=lint --all",
    "format": "nx run-many --target=format --all",
    "test": "nx run-many --target=test --all",
    "build": "nx run-many --target=build --all",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.0",
    "nx": "^21.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  }
}
