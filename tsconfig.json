{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Root solution tsconfig — references every package so editors and `tsc --build` see the whole graph. Docs: docs/monorepo/bun.md",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "files": [],
  "references": [
    { "path": "./lib/core" },
    { "path": "./lib/math" },
    { "path": "./packages/sdk" },
    { "path": "./apps/cli" },
    { "path": "./services/echo-service" }
  ]
}
